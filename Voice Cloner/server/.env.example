# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/voice_cloner"
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# File Upload Configuration
MAX_FILE_SIZE=50MB
UPLOAD_DIR=./uploads

# AI/ML Configuration
TENSORFLOW_MODEL_PATH=./models
VOICE_EMBEDDING_MODEL=ecapa-tdnn
TTS_MODEL=tortoise-tts

# External API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# WebSocket Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Voice Processing Configuration
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1
VOICE_CLONE_TIMEOUT=300000

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Cloud Storage Configuration (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=voice-cloner-storage