// This is your Prisma schema file for Docker deployment,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  fullName          String
  passwordHash      String
  isEmailVerified   Boolean  @default(false)
  emailVerificationToken String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  lastLoginAt       DateTime?
  profileImageUrl   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // User settings and preferences
  settings          UserSettings?
  
  // User's voice profiles
  voiceProfiles     VoiceProfile[]
  
  // User's voice cloning projects
  projects          VoiceProject[]
  
  // User's API usage tracking
  apiUsage          ApiUsage[]
  
  // Token blacklist entries
  tokenBlacklist    TokenBlacklist[]

  @@map("users")
}

model UserSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Privacy settings
  profileVisibility     ProfileVisibility @default(PRIVATE)
  allowDataCollection   Boolean           @default(false)
  
  // Notification preferences
  emailNotifications    Boolean           @default(true)
  pushNotifications     Boolean           @default(true)
  
  // Voice processing preferences
  defaultVoiceQuality   VoiceQuality      @default(STANDARD)
  defaultLanguage       String            @default("en-US")
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("user_settings")
}

model VoiceProfile {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name              String
  description       String?
  language          String         @default("en-US")
  gender            VoiceGender?
  ageRange          AgeRange?
  
  // Voice characteristics
  pitch             Float?
  speed             Float?
  emotion           String?
  accent            String?
  
  // Training data
  trainingStatus    TrainingStatus @default(PENDING)
  trainingProgress  Float?         @default(0)
  
  // Audio samples
  sampleAudioUrl    String?
  sampleDuration    Float?
  sampleQuality     VoiceQuality   @default(STANDARD)
  
  // Model information
  modelVersion      String?
  modelSize         Float?         // Size in MB
  
  isActive          Boolean        @default(true)
  isPublic          Boolean        @default(false)
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  // Related projects
  projects          VoiceProject[]

  @@map("voice_profiles")
}

model VoiceProject {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceProfileId      String?
  voiceProfile        VoiceProfile?    @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  
  name                String
  description         String?
  
  // Input configuration
  inputText           String?
  inputAudioUrl       String?
  inputLanguage       String           @default("en-US")
  
  // Output configuration
  outputAudioUrl      String?
  outputDuration      Float?
  outputQuality       VoiceQuality     @default(STANDARD)
  outputFormat        AudioFormat      @default(MP3)
  
  // Processing status
  status              ProcessingStatus @default(PENDING)
  progress            Float?           @default(0)
  errorMessage        String?
  
  // Processing metadata
  processingStartedAt DateTime?
  processingEndedAt   DateTime?
  processingDuration  Float?           // Duration in seconds
  
  // Quality metrics
  similarityScore     Float?           // 0-1 similarity to original voice
  qualityScore        Float?           // 0-1 overall quality score
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("voice_projects")
}

model ApiUsage {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  endpoint          String
  method            String
  statusCode        Int
  responseTime      Float     // Response time in milliseconds
  
  // Request metadata
  userAgent         String?
  ipAddress         String?
  requestSize       Int?      // Request size in bytes
  responseSize      Int?      // Response size in bytes
  
  // Usage tracking
  timestamp         DateTime  @default(now())
  date              DateTime  @default(now()) @db.Date
  
  @@map("api_usage")
  @@index([userId, date])
  @@index([endpoint, timestamp])
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tokenId   String   @unique // JTI from JWT
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@map("token_blacklist")
  @@index([tokenId])
  @@index([expiresAt])
}

// Enums
enum ProfileVisibility {
  PRIVATE
  FRIENDS
  PUBLIC
}

enum VoiceQuality {
  BASIC
  STANDARD
  HIGH
  PREMIUM
}

enum VoiceGender {
  MALE
  FEMALE
  NEUTRAL
}

enum AgeRange {
  CHILD      // 5-12
  TEEN       // 13-19
  YOUNG_ADULT // 20-35
  ADULT      // 36-55
  SENIOR     // 55+
}

enum TrainingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProcessingStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AudioFormat {
  MP3
  WAV
  FLAC
  OGG
}