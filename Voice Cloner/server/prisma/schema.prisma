// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  subscriptionTier  String   @default("FREE") // FREE, PREMIUM, ENTERPRISE
  isActive          Boolean  @default(true)
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  voiceModels       VoiceModel[]
  voiceCloneJobs    VoiceCloneJob[]
  apiKeys           ApiKey[]
  usageStats        UsageStats[]

  @@map("users")
}

model VoiceModel {
  id              String      @id @default(cuid())
  name            String
  description     String?
  language        String
  gender          String      // MALE, FEMALE, NEUTRAL
  isPublic        Boolean     @default(false)
  quality         String      // LOW, MEDIUM, HIGH, ULTRA
  fileUrl         String
  sampleAudioUrl  String?
  modelSize       Int?        // Size in bytes
  tags            String      // JSON string of tags array
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  owner           User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  cloneJobs       VoiceCloneJob[]
  synthesisTasks  SynthesisTask[]

  @@map("voice_models")
}

model VoiceCloneJob {
  id              String      @id @default(cuid())
  status          String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  progress        Int         @default(0)
  audioFileUrl    String
  modelName       String
  language        String
  gender          String      // MALE, FEMALE, NEUTRAL
  description     String?
  tags            String      // JSON string of tags array
  isPublic        Boolean     @default(false)
  errorMessage    String?
  processingTime  Int?        // Processing time in seconds
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  // Relations
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  resultModel     VoiceModel? @relation(fields: [resultModelId], references: [id])
  resultModelId   String?     @unique

  @@map("voice_clone_jobs")
}

model SynthesisTask {
  id              String      @id @default(cuid())
  text            String
  language        String
  emotionMode     String      @default("NEUTRAL") // NEUTRAL, HAPPY, SAD, EXCITED, etc.
  speed           Float       @default(1.0)
  pitch           Float       @default(1.0)
  status          String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  audioFileUrl    String?
  errorMessage    String?
  processingTime  Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  completedAt     DateTime?

  // Relations
  voiceModel      VoiceModel  @relation(fields: [voiceModelId], references: [id], onDelete: Cascade)
  voiceModelId    String

  @@map("synthesis_tasks")
}

model ApiKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @unique
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@map("api_keys")
}

model UsageStats {
  id                    String   @id @default(cuid())
  date                  DateTime @default(now())
  voiceModelsCreated    Int      @default(0)
  synthesisTasksRun     Int      @default(0)
  audioMinutesProcessed Float    @default(0)
  apiRequestsCount      Int      @default(0)

  // Relations
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  @@unique([userId, date])
  @@map("usage_stats")
}

model TokenBlacklist {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("token_blacklist")
}