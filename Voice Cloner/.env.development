# Development Environment Variables
# Copy this file to .env.development for local development

# Database Configuration
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=voice_cloner_dev
POSTGRES_USER=dev_user

# Redis Configuration (no password for development)
REDIS_PASSWORD=

# JWT Secrets (Use simple secrets for development)
JWT_SECRET=dev_jwt_secret_not_for_production
JWT_REFRESH_SECRET=dev_refresh_secret_not_for_production

# Security Settings (Relaxed for development)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# File Upload Settings
UPLOAD_MAX_SIZE=52428800

# Logging
LOG_LEVEL=debug

# Development Settings
NODE_ENV=development
PORT=5000