# Production Environment Variables
# Copy this file to .env.production and update with your production values

# Database Configuration
POSTGRES_PASSWORD=your_super_secure_postgres_password_here
POSTGRES_DB=voice_cloner
POSTGRES_USER=voice_cloner_user

# Redis Configuration
REDIS_PASSWORD=your_super_secure_redis_password_here

# JWT Secrets (Generate strong random strings)
JWT_SECRET=your_super_secure_jwt_secret_at_least_64_chars_long_change_this
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_at_least_64_chars_long_change_this

# Security Settings
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings
UPLOAD_MAX_SIZE=52428800

# Logging
LOG_LEVEL=info

# SSL/TLS (if using HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Email Configuration (if needed)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password

# Monitoring (Optional)
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10